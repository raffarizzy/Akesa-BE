api.akesa.cloud {
    # 1. Routing KTP OCR Gateway
    handle /api/v1/ktp/* {
        reverse_proxy akesa-ocr-backend:8081
    }

    # 2. Routing Backend Utama (REST API & Real-time WebSocket)
    handle {
        reverse_proxy akesa-backend:8080
    }

    log {
        output stdout
        format console
    }
}

