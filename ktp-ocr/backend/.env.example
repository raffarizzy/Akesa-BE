# Port server Go Gateway KTP OCR
# Bisa listen ke beberapa port sekaligus (misal 9090 dan 8081) dipisahkan tanda koma
PORT=9090,8081

# URL FastAPI AI Service (PP-OCRv4 ONNX)
AI_SERVICE_URL=http://localhost:8000

# Timeout request ke AI Service (detik)
TIMEOUT_SECONDS=60

# Gin Mode (debug / release)
GIN_MODE=debug
