# Port server Go Gateway KTP OCR
# (Default 8081 agar tidak bentrok dengan backend utama Akesa di port 8080)
PORT=8081

# URL FastAPI AI Service (PP-OCRv4 ONNX)
AI_SERVICE_URL=http://localhost:8000

# Timeout request ke AI Service (detik)
TIMEOUT_SECONDS=60

# Gin Mode (debug / release)
GIN_MODE=debug
